{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noErrorTruncation": true, // https://stackoverflow.com/a/53131824
    "baseUrl": ".",
    "paths": {
      "@app/*": ["./*"],
      // Bun global store: React libs (Headless UI, TanStack Router, …) realpath into
      // ~/.bun/install/cache/links, where their `react` import cannot find `@types/react`
      // and silently falls back to `any` (https://github.com/oven-sh/bun/issues/29727).
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "paraglide/**/*.ts",
    "paraglide/**/*.js",
    "**/*.test.ts"
  ],
  "exclude": ["node_modules"]
}
