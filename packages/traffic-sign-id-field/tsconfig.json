{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "lib": ["es2022", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noErrorTruncation": true
  },
  "include": ["src"],
  "exclude": [
    "dist",
    "node_modules",
    "vitest.config.ts",
    "**/*.test.ts",
    "src/createTrafficSignField.impl.ts",
    "src/fieldEntry.ts",
    "src/browser.ts"
  ]
}
